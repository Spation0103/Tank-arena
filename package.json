{
  "name": "tank-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w @tank-arena/client",
    "build": "npm run build -w @tank-arena/client && npm run build -w @tank-arena/server",
    "server": "npm run start -w @tank-arena/server",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/client/tests/*.test.js .test-dist/shared/tests/*.test.js .test-dist/server/tests/*.test.js && vitest run",
    "test:vitest": "vitest run",
    "test:shared": "vitest run --project shared",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench:clients": "npm run build -w @tank-arena/server && node scripts/load-test.mjs",
    "bench:worker": "node scripts/worker-benchmark.mjs",
    "profile:game": "npm run build && node scripts/profile-8-bots.mjs",
    "lint": "eslint client/src client/tests shared server e2e scripts vitest.config.ts playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.19.0",
    "fast-check": "^4.10.2",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "pino": "^9.6.0",
    "zod": "^4.6.7"
  }
}
