{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "server/build",
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"],
  "exclude": [
    "server/tests/**",
    "shared/tests/**",
    "**/build/**",
    "**/node_modules/**"
  ]
}
